venv/
.env
__pycache__/
*.pyc
*.pyo

# Model AI — file besar, tidak di-commit
models/*.pt
models/*.h5
models/*.onnx
models/*.pth

# ── Dataset Foto Lokal & Privasi ─────────────────────────────
